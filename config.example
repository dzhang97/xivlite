# xivlite configuration (~/.config/xivlite/config). You do not need to write it: `xivlite setup`
# asks for the account, password, authenticator secret and game folder and writes them here, the
# secrets encrypted. This file lists every setting, for anyone who wants the rest.
# One "key = value" per line. Values may be quoted; "#" starts a comment only at the start of a line.

# Account, written by setup as username_encrypted, password_encrypted and otp_secret_encrypted.
# Steam service accounts are not supported. Plain-text forms also work, with a warning:
# username = YourSquareEnixID
# password = ...        or   password_file = ~/path
# otp_secret = BASE32SECRET
# Where a keyring is available, the password can come from a command (first line of output):
# password_command = secret-tool lookup service xivlite user YourSquareEnixID

# The folder that holds boot/ and game/. Optional when launched through a command (Steam's
# %command%) that already names game/ffxiv_dx11.exe or boot/ffxivboot.exe.
# game_path = /root/Storage/SquareEnix/FINAL FANTASY XIV - A Realm Reborn

# japanese, english, german or french
language = english

# free_trial = no

# Pass the arguments encrypted, as the official launcher does (recommended).
# encrypt_args = yes

# When the game needs patches at launch: "install" downloads and installs them first; "boot" starts
# the official launcher (ffxivboot64.exe) instead; "fail" stops with an error.
# on_patch = install

# Where patches wait between download and install (default: .xivlite-patches in the game folder).
# patch_dir =

# Abort early when the login gate reports maintenance.
# check_gate = yes

# Extra game arguments, key=value words without spaces, e.g. SYS.ScreenMode=2
# extra_args =

# accept_language = en-US
